{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/status/:token", "destination": "/status.html" },
    { "source": "/admin/consultation/:id", "destination": "/admin.html" }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, must-revalidate" }]
    }
  ]
}
